paper/humanizer_chunks/
paper/all_manuscript_prose.txt
paper/all_manuscript_prose_450w_chunks.txt
paper/100percent_human_style_sample.txt
paper/humanizer_style_examples.txt
paper/humanizer_style_examples_v2.txt
